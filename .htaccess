# CryptoIndex Apache 配置（可选；Nginx 请参考 README）
Options -Indexes
DirectoryIndex index.php

# 保护配置、锁文件、日志与安装脚本（安装完成后建议直接删除 install.php）
<FilesMatch "^(config\.php|config\.sample\.php|.*\.lock|.*\.log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 伪静态（可选，站点默认使用 query string 形式，无需开启也能正常运行）
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^article/([0-9]+)\.html$ article.php?id=$1 [L,QSA]
  RewriteRule ^category/([^/]+)\.html$ index.php?cat=$1 [L,QSA]
  RewriteRule ^rss\.xml$ feed.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>
