# CryptoIndex Apache config (optional; see README for Nginx)
Options -Indexes
DirectoryIndex index.php

# Protect config, lock files, logs and the installer (delete install.php after setup)
<FilesMatch "^(config\.php|config\.sample\.php|.*\.lock|.*\.log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Optional pretty URLs (the site works with plain query strings too)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^article/([0-9]+)\.html$ article.php?id=$1 [L,QSA]
  RewriteRule ^category/([^/]+)\.html$ index.php?cat=$1 [L,QSA]
  RewriteRule ^rss\.xml$ feed.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>
